{
  "name": "hitradio-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "vapid": "node -e \"const k=require('web-push').generateVAPIDKeys();console.log('VAPID_PUBLIC_KEY='+k.publicKey);console.log('VAPID_PRIVATE_KEY='+k.privateKey)\"",
    "test": "node --test --import tsx --import ./tests/_setup.ts tests/schedule.test.ts tests/jwt.test.ts tests/rbac.test.ts tests/validation.test.ts tests/tenant.test.ts tests/http-rbac.test.ts tests/stripe.test.ts tests/analytics-bus.test.ts tests/analytics-ingest.test.ts tests/analytics-admin.test.ts tests/analytics-isolation.test.ts tests/beacon-guard.test.ts tests/geoip.test.ts",
    "tenant:guard": "node scripts/check-tenant-queries.mjs",
    "test:rls": "node scripts/test-rls.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@hono/node-server": "^1.13.1",
    "@sentry/node": "^8.55.2",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.3",
    "jose": "^5.9.3",
    "pg": "^8.13.0",
    "stripe": "^17.7.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.10",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
