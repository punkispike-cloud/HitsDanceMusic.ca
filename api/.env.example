# ─────────────────────────────────────────────────────────────────────────
#  Hits Dance Music — API : variables d'environnement
#  Copier en .env pour le dev local. En prod, configurées dans Railway.
#  Le service REFUSE de démarrer si JWT_SECRET ou DATABASE_URL manquent/faibles.
# ─────────────────────────────────────────────────────────────────────────

# Port d'écoute (Railway l'injecte automatiquement en prod)
PORT=8082
NODE_ENV=development

# PostgreSQL — runtime. En staging/prod une fois RLS activé :
#   DATABASE_URL=postgres://enondes_app:...@.../railway
#   MIGRATE_DATABASE_URL=postgres://postgres:...@.../railway  (owner, DDL + seed)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hitradio
# MIGRATE_DATABASE_URL=
# TLS Postgres : DATABASE_CA_CERT (PEM inline) pour vérifier le serveur, ou
# DB_SSL_INSECURE=1 (proxy TCP Railway sans CA — à éviter ailleurs).
# DATABASE_CA_CERT=
# DB_SSL_INSECURE=

# Origines autorisées (CSV, même format que le service presence)
ALLOWED_ORIGINS=http://localhost:3000,https://hitsdancemusic.ca,https://admin.hitsdancemusic.ca

# Secret JWT — ≥ 32 octets aléatoires. Générer : openssl rand -base64 48
JWT_SECRET=dev-only-change-me-please-32-bytes-minimum-secret

# Durées de vie des tokens (secondes)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Coût bcrypt (10–12 raisonnable)
BCRYPT_COST=12

# Cap taille body JSON (octets)
MAX_BODY_BYTES=1048576

# Rate limiting (requêtes / minute / IP)
RATE_LIMIT_RPM=120
AUTH_RATE_LIMIT_RPM=10

# SameSite du cookie refresh. Vide = auto (None en prod cross-site Railway,
# Lax en dev). Poser COOKIE_SAMESITE=lax une fois les domaines custom actifs.
# COOKIE_SAMESITE=

# ── Seed (npm run seed / preDeploy Railway) ──
# Bootstrap du premier superadmin
SEED_ADMIN_EMAIL=admin@hitsdancemusic.ca
SEED_ADMIN_PASSWORD=change-me-now
# Compte owner (opérateur du parc) et compte IT cross-radio — vides = non créés
# SEED_OWNER_EMAIL=
# SEED_OWNER_PASSWORD=
# SEED_IT_EMAIL=
# SEED_IT_PASSWORD=
# SEED_IT_NAME=Équipe IT
# Marque du tenant seedé (hitsdance, rockradio, …) + nom affiché (défaut : dérivé)
# SEED_BRAND=hitsdance
# SEED_RADIO_NAME=

# ── Web Push (rappels d'émission) — générer : npm run vapid ──
# Guide ops complet : ../DEPLOY-OPS.md §1
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@hitsdancemusic.ca

# ── AzuraCast (flux managé + replay automatique) ──
# Base URL de l'instance AzuraCast (sans slash final).
# AZURACAST_BASE_URL=https://radio.example.com
# AZURACAST_API_KEY=
# Ingestion des enregistrements en brouillons d'épisodes (désactivé par défaut).
# AZURACAST_REPLAY_ENABLED=false
# REPLAY_INTERVAL_MS=900000

# ── Stripe (facturation Phase 5) — inactif sans clés live ──
# STRIPE_SECRET=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs récurrents (dashboard Stripe) :
# STRIPE_PRICE_STARTER_ID=price_...
# STRIPE_PRICE_GROWTH_ID=price_...
# STRIPE_PRICE_PRO_ID=price_...
# Le webhook POST /v1/webhooks/stripe renvoie 503 tant que STRIPE_WEBHOOK_SECRET est absent.

# ── Stockage S3 / Cloudflare R2 (uploads audio) ──
# AWS S3 : laisser S3_ENDPOINT vide. R2 : poser S3_ENDPOINT + S3_REGION=auto + S3_FORCE_PATH_STYLE=true
S3_REGION=ca-central-1
S3_BUCKET=hits-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL publique/CDN du bucket (CloudFront ou domaine custom)
S3_PUBLIC_BASE_URL=https://media.hitsdancemusic.ca
# Endpoint S3 personnalisé (R2 : https://<accountid>.r2.cloudflarestorage.com)
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
# Taille max d'un fichier audio (octets) — 500 Mo
MAX_AUDIO_BYTES=524288000

# ── URL publique du site (liens RSS / partage / emails) ──
PUBLIC_SITE_URL=https://hitsdancemusic.ca
# URL de la console admin (liens d'invitation / reset envoyés par email)
ADMIN_BASE_URL=https://zucchini-charisma-production-3a67.up.railway.app

# URL du hub En Ondes (liens de reset auditeur). Passer à https://enondes.ca
# quand le DNS sera actif.
HUB_BASE_URL=https://enondes-hub-production.up.railway.app

# ── Monitoring du flux (alertes e-mail down/silence) ──
# NOWPLAYING_URL : endpoint now-playing sondé par le moniteur (vide = flux direct)
# NOWPLAYING_URL=
MONITOR_ENABLED=true
MONITOR_INTERVAL_MS=120000
# Titre inchangé > N min ⇒ dead-air suspecté ; pas de ré-alerte avant N min
STREAM_SILENCE_MIN=30
ALERT_DEBOUNCE_MIN=60

# ── Géo-IP locale (MMDB MaxMind/DB-IP — aucun IP envoyé à un tiers) ──
# GEOIP_DB_PATH=/data/GeoLite2-City.mmdb
# GEOIP_DISABLED=1

# ── Rétention analytics (Loi 25) — purge des sessions plus vieilles que N jours ──
ANALYTICS_RETENTION_DAYS=180

# ── Sentry (monitoring d'erreurs) — laisser vide pour désactiver ──
SENTRY_DSN=

# ── Resend (emails transactionnels + ALERTES D'ANTENNE) — vide = désactivé ──
# ⚠️ Vide en production = angle mort : le moniteur détecte un dead-air, écrit
# radios.health_status, puis n'alerte PERSONNE (monitor.ts). L'API le signale
# au boot et /health répond alors { monitor: true, alerts: false }.
# Le domaine d'EMAIL_FROM doit être VÉRIFIÉ chez Resend (SPF + DKIM + MAIL FROM)
# — il y a un délai DNS. Procédure : RUNBOOK-PRODUCTION.md § Vague 1.6.
RESEND_API_KEY=
EMAIL_FROM=Hits Dance Music <no-reply@hitsdancemusic.ca>
