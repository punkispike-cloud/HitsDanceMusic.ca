.git
.gitignore
README.md
fix-palette.ps1
fix-palette.py
*.md
node_modules

# Services backend déployés séparément — ne pas les embarquer dans l'image web (nginx)
api
admin
presence
enondes-site

# Marque / manifests npm : inutiles dans l'image HTML (nginx deny en complément)
# NB : nginx.conf et Dockerfile restent dans le contexte — le Dockerfile les COPY.
package.json
package-lock.json
brand

# Outils de build / dev inutiles dans l'image statique
scripts
tests
.claude
.vscode
*.ps1
*.py
.github

# Secrets & données locales — ne JAMAIS entrer dans l'image (audit G7)
.env
.env.*
_private
operator
test-results
.preview-rock
