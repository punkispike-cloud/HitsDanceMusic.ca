{
  "name": "hitsdance-tooling",
  "version": "1.0.0",
  "private": true,
  "description": "Outillage de build & tests visuels du site public Hits Dance Music / En Ondes.",
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "build:css": "node scripts/build-css.mjs",
    "build:css:minify": "node scripts/build-css-min.mjs",
    "check": "node scripts/build-all.mjs --check",
    "test": "node --test tests/",
    "test:unit": "node --test tests/",
    "test:visual": "playwright test --config=tests/visual/playwright.config.mjs",
    "snap:baseline": "playwright test --config=tests/visual/playwright.config.mjs --update-snapshots",
    "snap:check": "playwright test --config=tests/visual/playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "lightningcss": "^1.29.1"
  }
}
